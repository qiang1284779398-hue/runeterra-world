# Zhipu OpenAI-compatible endpoint. Keep secrets out of Git.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flashx

# Letta must be a reachable self-hosted/managed App Server.
LETTA_BASE_URL=http://letta:8283
LETTA_API_KEY=
LETTA_MODEL_HANDLE=

# Protect the Runeterra backend API.
RUNETERRA_API_TOKEN=change-me

# SQLite is suitable for a single-instance pilot. Use a persistent mounted volume.
RUNETERRA_DB=/data/runeterra.db
